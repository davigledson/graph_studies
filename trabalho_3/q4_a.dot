digraph PERT {
    rankdir=LR;

    1 -> 2 [label="C, 5"]
    3 -> 4 [label="A, 8"]
    4 -> 6 [label="J, 2"]
    5 -> 6 [label="B, 1"]
    6 -> 7 [label="G, 4"]
    3 -> 6 [label="I, 9"]

    edge [color=red, penwidth=2.5];

    3 -> 2 [style=dashed]; 
    2 -> 4 [label="E, 10"]; 
    5 -> 7 [label="F, 6"];  
    1 -> 3 [label="D, 8"]
    4 -> 5 [label="H, 5"]

    subgraph cluster {
        label="Caminho Crítico";
        critico [label="D→E→H→F", shape=plaintext];
    }
}